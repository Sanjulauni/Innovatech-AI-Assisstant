# =============================================================================
# InnovaTech AI Assistant — environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="InnovaTech AI Assistant"
LOG_LEVEL=INFO

# --- Model provider (v1 supports: gemini) ------------------------------------
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.1

# --- Gemini API --------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
# After changing the embedding model, re-ingest your documents.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Ingestion ---------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=20

# --- Retrieval ---------------------------------------------------------------
RETRIEVER_TOP_K=4

# --- API & UI ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Key required on protected endpoints (ingest/delete). Leave empty to disable in local dev.
API_KEY=
API_BASE_URL=http://127.0.0.1:8000