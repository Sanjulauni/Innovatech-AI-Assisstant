# =============================================================================
# InnovaTech AI Assistant — environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="InnovaTech AI Assistant"
LOG_LEVEL=INFO

# --- Chat model (Groq, free tier) --------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_TEMPERATURE=0.1
# Models the admin can pick from on the Admin page (comma-separated; the first is
# the default). Check https://console.groq.com/docs/models for current free models.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- Local chat model (optional) ----------------------------------------------
# A GGUF model run on this machine with llama.cpp's llama-server
# (https://github.com/ggml-org/llama.cpp/releases). Set both paths to add it to the
# Admin page's model list. The API starts the server when the model is selected and
# stops it when another model is chosen. Leave empty to offer only Groq models.
LOCAL_LLM_SERVER=
LOCAL_LLM_MODEL=
# e.g. LOCAL_LLM_SERVER=D:\llama-bin\llama-server.exe
#      LOCAL_LLM_MODEL=D:\gemma-4-E2B-it-Q4_K_M.gguf
# Name shown to the admin (default: the file name), e.g. "Gemma 4 E2B".
LOCAL_LLM_LABEL=
LOCAL_LLM_PORT=8080
LOCAL_LLM_CONTEXT_SIZE=8192
# Seconds to wait for the model to load.
LOCAL_LLM_STARTUP_TIMEOUT=180
# Extra llama-server options, e.g. --threads 4. The API already passes
# "--reasoning off --parallel 1"; options here override those.
LOCAL_LLM_ARGS=
# A CPU reads prompts slowly, so the local model gets fewer document excerpts and
# earlier messages than the cloud models (RETRIEVER_TOP_K / CHAT_HISTORY_LIMIT).
LOCAL_LLM_TOP_K=2
LOCAL_LLM_HISTORY_LIMIT=2
# If the local model was started only to answer confidential questions (a cloud
# model is selected), stop it after this many idle minutes to free its memory.
LOCAL_LLM_IDLE_MINUTES=15
# llama-server's output, for troubleshooting.
LOCAL_LLM_LOG_FILE=data/logs/llama-server.log

# --- Embeddings (local, free, no API) -----------------------------------------
# Runs on your CPU with FastEmbed; downloaded once (~70 MB) to EMBEDDING_CACHE_DIR.
# After changing the embedding model, use "Re-index saved files" on the Admin page.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=data/models

# --- Ingestion ---------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Largest upload accepted. The admin can change it on the Admin page (Documents tab),
# up to MAX_UPLOAD_SIZE_CAP_MB; their choice is saved in UPLOAD_LIMIT_FILE.
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_SIZE_CAP_MB=200
UPLOAD_LIMIT_FILE=data/upload_limit.json

# --- Retrieval & chat --------------------------------------------------------
RETRIEVER_TOP_K=4
# Previous chat messages (user + assistant) sent along with each question.
CHAT_HISTORY_LIMIT=6

# --- Admin -------------------------------------------------------------------
# Password for the admin page and /admin API endpoints (ASCII characters only).
# Leave empty to disable admin.
ADMIN_PASSWORD=
# How long an admin stays logged in to the web app.
ADMIN_SESSION_HOURS=8
# Where the admin's agent instructions (tone, rules, escalation contacts) are saved.
INSTRUCTIONS_FILE=data/agent_instructions.json
# Documents the admin marked confidential (only the local model may read them).
# The API refuses to start if this file is unreadable, rather than risk sending
# confidential text to a cloud model.
CONFIDENTIAL_FILE=data/confidential_documents.json

# --- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000